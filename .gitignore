# Rust (the shipped service binary)
/target/

# Node reference implementation (node/)
node_modules/
node/node_modules/

# Misc
*.log
.env
.DS_Store
dist/

# Runtime node state — never commit (control token is a local secret generated at
# runtime into the OS config dir; config.json is local node config).
control-token
config.json
.gitnexus/


# lane-local scratch (never committed)
.lane/


# gitnexus writes agent-tooling files into the repository it indexes. They are
# development-loop private and must never be tracked here.
# See DIG-Network/dig_ecosystem#3177. Prefer `gitnexus analyze --skip-agents-md`.
/AGENTS.md
/CLAUDE.md
/.claude/skills/gitnexus/
/.claude/skills/generated/
/.gitnexus/
