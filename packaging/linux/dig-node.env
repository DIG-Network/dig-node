# /etc/dig-node/dig-node.env — the dig-node service's environment, read by
# net.dignetwork.dig-node.service. Edit this file, then restart the service:
#
#   systemctl restart net.dignetwork.dig-node.service
#
# It is a dpkg conffile, so your edits survive an upgrade.
#
# Every setting below is COMMENTED OUT. An untouched file therefore changes nothing: the node
# uses its compiled-in defaults and finds peers on the public network, which is what an ordinary
# install should do (dig_ecosystem#923).

# --- Running an ISOLATED node (dig-node#317) --------------------------------------------------
#
# To stand up a node on a private network with no route to the public one, uncomment BOTH lines
# below and give DIG_BOOTSTRAP_PEERS the peers of your own network (or leave it `off` for a node
# that dials nobody and waits to be dialled).
#
# To keep the node off the public network from the very first second, drop the marker BEFORE
# installing the package:
#
#   mkdir -p /etc/dig-node
#   touch /etc/dig-node/no-autostart
#   apt install ./dig-node_<version>_<arch>.deb
#   # ...edit this file...
#   systemctl enable --now net.dignetwork.dig-node.service
#
# Without the marker the package starts the node immediately, and it will have joined the public
# DHT — and left a provider record behind it — before your configuration lands.
#
# Write `off`, NOT an empty value. `off` and an empty value mean the same thing to the node, but
# an empty assignment does not survive every tool that carries it (on Windows an empty
# environment variable is deleted rather than emptied, and an unset variable falls back to the
# public anchor). `off` is a non-empty token that means "none" everywhere.
#
# A private peer is written `<64-hex-peer-id>@<host>:<port>`. Hosts may be IPv6 — write the
# literal in brackets, e.g. `...@[2001:db8::10]:4444` — and IPv6 is preferred where both are
# available.

#DIG_BOOTSTRAP_PEERS=off
#DIG_RELAY_URL=off
